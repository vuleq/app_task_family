rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user belongs to a family
    function isFamilyMember(familyId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/families/$(familyId)) &&
        request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.memberIds;
    }

    // Helper: check if user is root of a family
    function isFamilyRoot(familyId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/families/$(familyId)) &&
        get(/databases/$(database)/documents/families/$(familyId)).data.rootId == request.auth.uid;
    }

    // Users collection
    match /users/{userId} {
      // Any authenticated user can read basic user info (needed for task assignment)
      allow read: if request.auth != null;
      // Only the user themselves can write their own document
      allow write: if request.auth != null && request.auth.uid == userId;

      match /profile/{profileId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Families collection
    match /families/{familyId} {
      allow read: if request.auth != null;
      // Any authenticated user can create a new family
      allow create: if request.auth != null;
      // Only family members can update (join, leave, update info)
      allow update: if isFamilyMember(familyId) || isFamilyRoot(familyId);
      // Only root can delete the family
      allow delete: if isFamilyRoot(familyId);
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if request.auth != null;
      // Only family root/members can create tasks
      allow create: if request.auth != null;
      // Only the assignee or root can update a task
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.assignedTo ||
        request.auth.uid == resource.data.createdBy
      );
      // Only the creator can delete a task
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }

    // Task Templates collection
    match /taskTemplates/{templateId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.createdBy;
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }

    // Recurring Task Definitions - created by root, read by assigned member
    match /recurringTaskDefs/{defId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.createdBy;
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }

    // Rewards/Shop collection
    match /rewards/{rewardId} {
      allow read: if request.auth != null;
      // Only the creator/root can manage rewards
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.createdBy;
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }

    // User rewards (purchased items) - only owner can read/write
    match /userRewards/{userRewardId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Login History - append only, owner read
    match /loginHistory/{loginId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Chests collection - only owner can read/write
    match /chests/{chestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.createdBy;
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }

    // User chests - only owner
    match /userChests/{userChestId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Completion tracking - append only, owner read
    match /dailyCompletions/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false;
    }

    match /weeklyCompletions/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false;
    }

    match /monthlyCompletions/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false;
    }
  }
}
