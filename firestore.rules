rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Test rule - remove after fixing permission issue
    match /test_connectivity/{docId} {
      allow read: if request.auth != null;
    }

    // Users collection
    match /users/{userId} {
      // Cho phép đọc tất cả users (để assign task), nhưng chỉ cho phép ghi user của chính mình
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // User profile
      match /profile/{profileId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Families collection
    match /families/{familyId} {
      // Cho phép đọc nếu đã đăng nhập
      allow read: if request.auth != null;
      // Cho phép tạo family mới nếu đã đăng nhập
      allow create: if request.auth != null;
      // Cho phép update nếu đã đăng nhập (join family, update member count, etc.)
      allow update: if request.auth != null;
      // Cho phép xóa family nếu đã đăng nhập (root user xóa family)
      allow delete: if request.auth != null;
    }
    
    // Tasks collection
    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    // Task Templates collection
    match /taskTemplates/{templateId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.createdBy;
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }
    
    // Rewards/Shop collection
    match /rewards/{rewardId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // User rewards (purchased items)
    match /userRewards/{userRewardId} {
      allow read, write: if request.auth != null;
    }

    // Login History collection
    match /loginHistory/{loginId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Chests collection (reward chests)
    match /chests/{chestId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // User chests (opened chests per user)
    match /userChests/{userChestId} {
      allow read, write: if request.auth != null;
    }

    // Daily/Weekly/Monthly completion tracking
    match /dailyCompletions/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /weeklyCompletions/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /monthlyCompletions/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}

