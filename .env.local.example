# ============================================
# Firebase Configuration (BAT BUOC)
# ============================================
# Lay thong tin tu Firebase Console: https://console.firebase.google.com/
# Project Settings > Your apps > Web app (hoac Add app > Web)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ============================================
# Cloudinary Configuration (BAT BUOC cho upload anh)
# ============================================
# Lay thong tin tu Cloudinary Console: https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your_cloudinary_api_key
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ============================================
# Super Root Code (TUY CHON) - SERVER SIDE ONLY
# ============================================
# Ma code de tao Super Root user (quan ly tat ca families)
# KHONG co prefix NEXT_PUBLIC_ nen se KHONG bi lo ra browser
# Neu khong set, mac dinh la: SUPERADMIN2024
# QUAN TRONG: Doi thanh ma phuc tap, kho doan truoc khi deploy
SUPER_ROOT_CODE=your_super_secret_code_here

# ============================================
# Background Images (TUY CHON)
# ============================================
NEXT_PUBLIC_BACKGROUND_IMAGE_1=https://example.com/background1.png
NEXT_PUBLIC_BACKGROUND_IMAGE_2=https://example.com/background2.png

# ============================================
# Background Music (TUY CHON)
# ============================================
# Cach 1: Playlist (comma-separated URLs) - UU TIEN CAO NHAT
# NEXT_PUBLIC_BACKGROUND_MUSIC_PLAYLIST=https://example.com/music1.mp3,https://example.com/music2.mp3

# Cach 2: Single URL
NEXT_PUBLIC_BACKGROUND_MUSIC_URL=https://example.com/music.mp3

# Cach 3: Multiple URLs
# NEXT_PUBLIC_BACKGROUND_MUSIC_URL_1=https://example.com/music1.mp3
# NEXT_PUBLIC_BACKGROUND_MUSIC_URL_2=https://example.com/music2.mp3
